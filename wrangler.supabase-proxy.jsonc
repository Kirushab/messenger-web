{
  // Reverse proxy для Supabase API/Auth/Storage/Realtime/Functions.
  // Деплой: npx wrangler deploy -c wrangler.supabase-proxy.jsonc
  "name": "messenger-supabase-proxy",
  "main": "workers/supabase-proxy.ts",
  "compatibility_date": "2026-06-29",
  "vars": {
    "SUPABASE_UPSTREAM_URL": "https://your-project.supabase.co",
    "ALLOWED_ORIGINS": "https://your-app.example.com,http://localhost:5173",
    "ALLOW_NO_ORIGIN": "true"
  }
}
