{
  "name": "messenger-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.js",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify:release": "npm run check:tokens && npm run typecheck && npm run scan:secrets && npm run build",
    "proxy:deploy": "npx wrangler deploy -c wrangler.supabase-proxy.jsonc",
    "proxy:dev": "npx wrangler dev -c wrangler.supabase-proxy.jsonc"
  },
  "dependencies": {
    "@100mslive/hms-video-store": "^0.12.0",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.45.0",
    "chess.js": "^1.4.0",
    "mapbox-gl": "^3.23.1",
    "peerjs": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
