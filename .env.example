# Client variables exposed to Vite. VITE_* values are public in the browser bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Optional: use your own reverse proxy origin when direct *.supabase.co access is unstable/blocked.
# Do not include a path here; use a dedicated origin/subdomain.
VITE_SUPABASE_PROXY_URL=
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SENTRY_DSN=
# Public VAPID key generated together with WEB_PUSH_PRIVATE_KEY. Safe to expose to the browser.
VITE_WEB_PUSH_PUBLIC_KEY=your-public-vapid-key
VITE_APP_VERSION=v391

# Build-only. Keep false for public TestFlight/production builds unless CI uploads maps privately to Sentry.
BUILD_SOURCEMAPS=false

# Supabase Edge Function secrets. DO NOT prefix with VITE_ and DO NOT put into client code.
# Set with: supabase secrets set HMS_ACCESS_KEY=... HMS_SECRET=... AIRLABS_API_KEY=...
HMS_ACCESS_KEY=server-only-100ms-access-key
HMS_SECRET=server-only-100ms-secret
AIRLABS_API_KEY=server-only-airlabs-key
SUPABASE_SERVICE_ROLE_KEY=server-only-supabase-service-role-key
WEB_PUSH_PUBLIC_KEY=server-public-vapid-key
WEB_PUSH_PRIVATE_KEY=server-private-vapid-key
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Cloudflare Worker Supabase proxy variables. Configure in wrangler.supabase-proxy.jsonc or Cloudflare dashboard.
# The Worker keeps the direct Supabase host server-side while the app uses VITE_SUPABASE_PROXY_URL.
SUPABASE_UPSTREAM_URL=https://your-project.supabase.co
ALLOWED_ORIGINS=https://your-app.example.com,http://localhost:5173
ALLOW_NO_ORIGIN=true
